<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:agent="http://fluxnova.finos.org/schema/1.0/ai/agent" xmlns:modeler="http://fluxnova.org/schema/modeler/1.0" id="Definitions_CardDisputeAgent" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Fluxnova Modeler" modeler:executionPlatform="Fluxnova Platform">
  <bpmn:process id="card-dispute-agent" name="Card Dispute Agent" isExecutable="true" camunda:historyTimeToLive="P1D">
    <bpmn:startEvent id="dispute-received" name="Card dispute received">
      <bpmn:outgoing>flow-to-agent</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="flow-to-agent" sourceRef="dispute-received" targetRef="dispute-agent" />

    <!--
      The agentic subprocess: on entry the orchestrator calls the LLM with the system prompt and
      the agent:context variables. Every child activity is a tool the LLM can call. The loop ends
      when the LLM answers without calling a tool.

      provider="llm" is mapped to the OpenAI or Anthropic chat model in application.yml
      (LLM_PROVIDER). The model attribute is required, but the plugin does not use it yet: the model
      comes from OPENAI_MODEL / ANTHROPIC_MODEL.
    -->
    <bpmn:adHocSubProcess id="dispute-agent" name="Dispute triage agent">
      <bpmn:extensionElements>
        <agent:config provider="llm" model="configured-in-application-yml" systemPrompt="You are a card dispute triage agent at a retail bank. Resolve the dispute described in the context by calling tools. Follow these rules in order:&#10;1. First call lookupCustomer and lookupTransaction.&#10;2. Then call exactly one decision tool:&#10;   - rejectDispute if the customer's standing is not GOOD, or disputesLast12Months is 3 or more.&#10;   - escalateToAnalyst if the amount is over 100 USD or merchantRisk is HIGH.&#10;   - issueProvisionalCredit otherwise.&#10;3. As soon as disputeDecision appears in the context, stop: do not call any more tools. Reply with one sentence that explains the decision." />
        <agent:context>
          <agent:variable name="customerId" />
          <agent:variable name="transactionId" />
          <agent:variable name="disputeReason" />
          <agent:variable name="customerProfile" />
          <agent:variable name="transactionDetails" />
          <agent:variable name="disputeDecision" />
        </agent:context>
      </bpmn:extensionElements>
      <bpmn:incoming>flow-to-agent</bpmn:incoming>
      <bpmn:outgoing>flow-to-decision</bpmn:outgoing>

      <bpmn:serviceTask id="lookupCustomer" name="Look up customer" camunda:asyncBefore="true" camunda:expression="${disputeData.customer(id)}" camunda:resultVariable="result">
        <bpmn:documentation>Loads the customer's name, tier, account standing and number of disputes in the last 12 months.</bpmn:documentation>
        <bpmn:extensionElements>
          <camunda:inputOutput>
            <camunda:inputParameter name="id">${customerId}</camunda:inputParameter>
            <camunda:outputParameter name="customerProfile">${result}</camunda:outputParameter>
          </camunda:inputOutput>
        </bpmn:extensionElements>
      </bpmn:serviceTask>

      <bpmn:serviceTask id="lookupTransaction" name="Look up transaction" camunda:asyncBefore="true" camunda:expression="${disputeData.transaction(id)}" camunda:resultVariable="result">
        <bpmn:documentation>Loads the disputed card transaction: merchant, amount, channel and merchant risk rating.</bpmn:documentation>
        <bpmn:extensionElements>
          <camunda:inputOutput>
            <camunda:inputParameter name="id">${transactionId}</camunda:inputParameter>
            <camunda:outputParameter name="transactionDetails">${result}</camunda:outputParameter>
          </camunda:inputOutput>
        </bpmn:extensionElements>
      </bpmn:serviceTask>

      <bpmn:serviceTask id="issueProvisionalCredit" name="Issue provisional credit" camunda:asyncBefore="true" camunda:expression="${true}">
        <bpmn:documentation>Credits the disputed amount to the customer while the dispute is investigated. Final decision.</bpmn:documentation>
        <bpmn:extensionElements>
          <camunda:inputOutput>
            <camunda:outputParameter name="disputeDecision">PROVISIONAL_CREDIT</camunda:outputParameter>
            <camunda:outputParameter name="decidedBy">agent</camunda:outputParameter>
          </camunda:inputOutput>
        </bpmn:extensionElements>
      </bpmn:serviceTask>

      <bpmn:serviceTask id="rejectDispute" name="Reject dispute" camunda:asyncBefore="true" camunda:expression="${true}">
        <bpmn:documentation>Rejects the dispute without a credit. Final decision.</bpmn:documentation>
        <bpmn:extensionElements>
          <camunda:inputOutput>
            <camunda:outputParameter name="disputeDecision">REJECTED</camunda:outputParameter>
            <camunda:outputParameter name="decidedBy">agent</camunda:outputParameter>
          </camunda:inputOutput>
        </bpmn:extensionElements>
      </bpmn:serviceTask>

      <!-- Human in the loop: a user task is a tool too. The agent waits until the analyst completes it. -->
      <bpmn:userTask id="escalateToAnalyst" name="Escalate to fraud analyst" camunda:assignee="demo">
        <bpmn:documentation>Hands the dispute to a human fraud analyst, who decides. Final decision.</bpmn:documentation>
        <bpmn:extensionElements>
          <camunda:formData>
            <camunda:formField id="analystDecision" label="Decision" type="enum">
              <camunda:value id="APPROVE_CREDIT" name="Approve provisional credit" />
              <camunda:value id="REJECT" name="Reject dispute" />
            </camunda:formField>
          </camunda:formData>
          <camunda:inputOutput>
            <camunda:outputParameter name="disputeDecision">${analystDecision == 'APPROVE_CREDIT' ? 'PROVISIONAL_CREDIT' : 'REJECTED'}</camunda:outputParameter>
            <camunda:outputParameter name="decidedBy">analyst</camunda:outputParameter>
          </camunda:inputOutput>
        </bpmn:extensionElements>
      </bpmn:userTask>
    </bpmn:adHocSubProcess>

    <bpmn:sequenceFlow id="flow-to-decision" sourceRef="dispute-agent" targetRef="decision" />
    <!-- Guardrail: the process, not the LLM, decides what happens next. No decision means manual review. -->
    <bpmn:exclusiveGateway id="decision" name="Decision?" default="flow-no-decision">
      <bpmn:incoming>flow-to-decision</bpmn:incoming>
      <bpmn:outgoing>flow-credit</bpmn:outgoing>
      <bpmn:outgoing>flow-rejected</bpmn:outgoing>
      <bpmn:outgoing>flow-no-decision</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow-credit" name="Provisional credit" sourceRef="decision" targetRef="credit-issued">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${execution.getVariable('disputeDecision') == 'PROVISIONAL_CREDIT'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow-rejected" name="Rejected" sourceRef="decision" targetRef="dispute-rejected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${execution.getVariable('disputeDecision') == 'REJECTED'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow-no-decision" name="No decision" sourceRef="decision" targetRef="manual-review" />
    <bpmn:endEvent id="credit-issued" name="Provisional credit issued">
      <bpmn:incoming>flow-credit</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="dispute-rejected" name="Dispute rejected">
      <bpmn:incoming>flow-rejected</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="manual-review" name="Manual review" camunda:assignee="demo">
      <bpmn:documentation>The agent finished without a decision.</bpmn:documentation>
      <bpmn:incoming>flow-no-decision</bpmn:incoming>
      <bpmn:outgoing>flow-reviewed</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="flow-reviewed" sourceRef="manual-review" targetRef="reviewed" />
    <bpmn:endEvent id="reviewed" name="Reviewed manually">
      <bpmn:incoming>flow-reviewed</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_CardDisputeAgent">
    <bpmndi:BPMNPlane id="BPMNPlane_CardDisputeAgent" bpmnElement="card-dispute-agent">
      <bpmndi:BPMNShape id="dispute-received_di" bpmnElement="dispute-received">
        <dc:Bounds x="152" y="232" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="130" y="275" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dispute-agent_di" bpmnElement="dispute-agent" isExpanded="true">
        <dc:Bounds x="240" y="80" width="500" height="340" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lookupCustomer_di" bpmnElement="lookupCustomer">
        <dc:Bounds x="280" y="120" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lookupTransaction_di" bpmnElement="lookupTransaction">
        <dc:Bounds x="440" y="120" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="escalateToAnalyst_di" bpmnElement="escalateToAnalyst">
        <dc:Bounds x="600" y="120" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="issueProvisionalCredit_di" bpmnElement="issueProvisionalCredit">
        <dc:Bounds x="280" y="290" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="rejectDispute_di" bpmnElement="rejectDispute">
        <dc:Bounds x="440" y="290" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="decision_di" bpmnElement="decision" isMarkerVisible="true">
        <dc:Bounds x="795" y="225" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="795" y="195" width="50" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="credit-issued_di" bpmnElement="credit-issued">
        <dc:Bounds x="952" y="112" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="930" y="155" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dispute-rejected_di" bpmnElement="dispute-rejected">
        <dc:Bounds x="952" y="232" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="930" y="275" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="manual-review_di" bpmnElement="manual-review">
        <dc:Bounds x="920" y="330" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="reviewed_di" bpmnElement="reviewed">
        <dc:Bounds x="1082" y="352" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1060" y="395" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow-to-agent_di" bpmnElement="flow-to-agent">
        <di:waypoint x="188" y="250" />
        <di:waypoint x="240" y="250" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-to-decision_di" bpmnElement="flow-to-decision">
        <di:waypoint x="740" y="250" />
        <di:waypoint x="795" y="250" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-credit_di" bpmnElement="flow-credit">
        <di:waypoint x="820" y="225" />
        <di:waypoint x="820" y="130" />
        <di:waypoint x="952" y="130" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="830" y="112" width="90" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-rejected_di" bpmnElement="flow-rejected">
        <di:waypoint x="845" y="250" />
        <di:waypoint x="952" y="250" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="870" y="232" width="45" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-no-decision_di" bpmnElement="flow-no-decision">
        <di:waypoint x="820" y="275" />
        <di:waypoint x="820" y="370" />
        <di:waypoint x="920" y="370" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="830" y="352" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-reviewed_di" bpmnElement="flow-reviewed">
        <di:waypoint x="1020" y="370" />
        <di:waypoint x="1082" y="370" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
